<!--
  Panel, Divider, Button, ButtonIcon, and ButtonLabel come from the bundled
  Horizon kit. RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 48px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .sub-heading {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    width: 100%;
    margin-top: 10px;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Loci</div>
    <Divider></Divider>
    <!-- Keep in sync with src/loci/guide.ts (single source of truth) -->
    <!-- GENERATED from src/loci/guide.ts by scripts/sync-welcome.mjs — do not hand-edit between the markers. -->
        <!-- GENERATED from src/loci/guide.ts by scripts/sync-welcome.mjs — do not hand-edit between the markers. -->
    <!-- SYNC:WELCOME START -->
    <div class="sub-heading">
      Capture - Type, speak, or press a seed card to spill a set.
      Organize - Touch the glowing orb — your thoughts snap into connected clusters.
      Arrange - Grab and drag any card. Your placements are never overwritten.
      Recall - The violet orb quizzes your weakest notes — answer by touch or voice.
      Rewind - Scrub the dial at the edge of the void to watch your palace grow.
      Persist - Everything autosaves. Export a backup from the question-mark menu.
    </div>
    <!-- SYNC:WELCOME END -->
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
